<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.3.0</version>
  <description>Launch and config for the robot framework (task + control stacks).</description>
  <maintainer email="stereo.39bouvier@icloud.com">stereo</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_profile</exec_depend>
  <exec_depend>robot_runtime</exec_depend>
  <exec_depend>robot_hardware_plugins</exec_depend>
  <exec_depend>robot_navigation_adapters</exec_depend>
  <exec_depend>robot_manipulation_adapters</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
